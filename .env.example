# Copie este arquivo para ".env" na raiz do repositório e preencha os valores.
# O ".env" NÃO é versionado. Nunca commite chaves ou senhas reais.

# --- Banco PostgreSQL (usado pelo docker compose e pelo backend) ---
POSTGRES_DB=gametracker
POSTGRES_USER=gametracker
POSTGRES_PASSWORD=

# --- Segurança ---
# Chave HS256 do JWT em Base64, com 32 bytes ou mais. Gere com: openssl rand -base64 32
APP_SECURITY_JWT_SECRET=
APP_SECURITY_JWT_EXPIRATION_MINUTES=60

# Administrador criado na primeira subida (deixe em branco para não criar)
APP_BOOTSTRAP_ADMIN_NAME=Administrador inicial
APP_BOOTSTRAP_ADMIN_EMAIL=admin@admin.local
APP_BOOTSTRAP_ADMIN_PASSWORD=admin12345

# --- Outros ---
# Origens liberadas no CORS (o frontend do docker compose é servido em http://localhost:4200)
CORS_ORIGENS=http://localhost:4200
# Desliga as rotinas de prazo do marketplace (reserva, envio, custódia) se necessário
APP_MARKETPLACE_ROTINAS=true
